{
  "DevSpec Document Skeleton": {
    "prefix": "dsdoc",
    "body": [
      "# ${1:Document Title}",
      "",
      ":pdf-title: ${1:Document Title}",
      ":pdf-version: ${2:1.0.0}",
      ":pdf-owner: ${3:Owner}",
      "",
      "## Update History",
      "",
      "| Version | Date | Author | Changes |",
      "|---|---|---|---|",
      "| ${2:1.0.0} | ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE} | ${3:Owner} | Initial version |",
      "",
      "## 1. Introduction",
      "",
      "${4:Describe the background, purpose, and scope of this DevSpec.}",
      "",
      "## 2. Requirements",
      "",
      "| ID | Requirement | Priority | Notes |",
      "|---|---|---|---|",
      "| REQ-001 | ${5:Requirement description} | High | ${6:Notes} |",
      "",
      "## 3. Architecture",
      "",
      "```mermaid",
      "flowchart TD",
      "    A[Client] --> B[API]",
      "    B --> C[Service]",
      "    C --> D[Database]",
      "```",
      "",
      "## 4. API Design",
      "",
      "### 4.1 ${7:Endpoint Name}",
      "",
      "| Item | Value |",
      "|---|---|",
      "| Method | `${8:GET}` |",
      "| Path | `${9:/v1/resource}` |",
      "| Auth | `${10:Required}` |",
      "| Description | ${11:Description} |",
      "",
      "## 5. Error Handling",
      "",
      "| Code | Message | Cause | Action |",
      "|---|---|---|---|",
      "| `${12:ERROR_CODE}` | ${13:Message} | ${14:Cause} | ${15:Action} |",
      "",
      "## 6. Test Cases",
      "",
      "| ID | Scenario | Input | Expected Result |",
      "|---|---|---|---|",
      "| TC-001 | ${16:Scenario} | ${17:Input} | ${18:Expected result} |",
      "",
      "## 7. Risks and Open Questions",
      "",
      "- [ ] ${19:Open question}",
      "",
      "$0"
    ],
    "description": "Create a full DevSpec document skeleton."
  },
  "DevSpec API Section": {
    "prefix": "dsapi",
    "body": [
      "### ${1:Endpoint Name}",
      "",
      "| Item | Value |",
      "|---|---|",
      "| Method | `${2:GET}` |",
      "| Path | `${3:/v1/resource}` |",
      "| Auth | `${4:Required}` |",
      "| Description | ${5:Description} |",
      "",
      "#### Request Parameters",
      "",
      "| Name | Type | Required | Description |",
      "|---|---|---:|---|",
      "| `${6:param}` | `${7:string}` | ${8:Yes} | ${9:Description} |",
      "",
      "#### Request Example",
      "",
      "```json",
      "{",
      "  \"${10:key}\": \"${11:value}\"",
      "}",
      "```",
      "",
      "#### Response Example",
      "",
      "```json",
      "{",
      "  \"${12:key}\": \"${13:value}\"",
      "}",
      "```",
      "",
      "#### Error Codes",
      "",
      "| Code | Message | Description |",
      "|---|---|---|",
      "| `${14:ERROR_CODE}` | ${15:Message} | ${16:Description} |",
      "",
      "$0"
    ],
    "description": "Insert a DevSpec API endpoint section."
  },
  "DevSpec Database Table Section": {
    "prefix": "dsdb",
    "body": [
      "### ${1:Table Name}",
      "",
      "| Item | Value |",
      "|---|---|",
      "| Physical name | `${2:table_name}` |",
      "| Purpose | ${3:Purpose of this table} |",
      "",
      "#### Columns",
      "",
      "| Column | Type | Nullable | Key | Description |",
      "|---|---|---:|---|---|",
      "| `${4:id}` | `${5:BIGINT}` | No | PK | ${6:Primary key} |",
      "",
      "#### Indexes",
      "",
      "| Index | Columns | Unique | Purpose |",
      "|---|---|---:|---|",
      "| `${7:idx_name}` | `${8:column_name}` | ${9:No} | ${10:Purpose} |",
      "",
      "$0"
    ],
    "description": "Insert a database table design section."
  },
  "DevSpec Mermaid Flowchart": {
    "prefix": "dsflow",
    "body": [
      "```mermaid",
      "flowchart TD",
      "    A[${1:Start}] --> B[${2:Process}]",
      "    B --> C{${3:Decision?}}",
      "    C -->|Yes| D[${4:Success}]",
      "    C -->|No| E[${5:Failure}]",
      "```",
      "$0"
    ],
    "description": "Insert a Mermaid flowchart."
  },
  "DevSpec Mermaid State Diagram": {
    "prefix": "dsstate",
    "body": [
      "```mermaid",
      "stateDiagram-v2",
      "    [*] --> ${1:Created}",
      "    ${1:Created} --> ${2:Running}: ${3:start}",
      "    ${2:Running} --> ${4:Completed}: ${5:success}",
      "    ${2:Running} --> ${6:Failed}: ${7:error}",
      "    ${4:Completed} --> [*]",
      "    ${6:Failed} --> [*]",
      "```",
      "$0"
    ],
    "description": "Insert a Mermaid state diagram."
  },
  "DevSpec PlantUML Sequence": {
    "prefix": "dsseq",
    "body": [
      "```plantuml",
      "@startuml",
      "actor ${1:User}",
      "participant \"${2:Public API}\" as PublicApi",
      "participant \"${3:Service}\" as Service",
      "database \"${4:Database}\" as Db",
      "",
      "${1:User} -> PublicApi: ${5:Request}",
      "PublicApi -> Service: ${6:Forward request}",
      "Service -> Db: ${7:Read/Write data}",
      "Db --> Service: ${8:Result}",
      "Service --> PublicApi: ${9:Response}",
      "PublicApi --> ${1:User}: ${10:Result}",
      "@enduml",
      "```",
      "$0"
    ],
    "description": "Insert a PlantUML sequence diagram."
  },
  "DevSpec Error Table": {
    "prefix": "dserror",
    "body": [
      "| Code | HTTP Status | Message | Cause | Action |",
      "|---|---:|---|---|---|",
      "| `${1:ERROR_CODE}` | ${2:400} | ${3:Message} | ${4:Cause} | ${5:Action} |",
      "$0"
    ],
    "description": "Insert an error code table."
  },
  "DevSpec Test Cases": {
    "prefix": "dstest",
    "body": [
      "| ID | Scenario | Steps | Expected Result |",
      "|---|---|---|---|",
      "| TC-001 | ${1:Scenario} | ${2:Steps} | ${3:Expected result} |",
      "$0"
    ],
    "description": "Insert a test case table."
  },
  "DevSpec Decision Log": {
    "prefix": "dsdecision",
    "body": [
      "### Decision: ${1:Decision Title}",
      "",
      "| Item | Description |",
      "|---|---|",
      "| Status | `${2:Proposed}` |",
      "| Date | `${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}` |",
      "| Owner | ${3:Owner} |",
      "",
      "#### Context",
      "",
      "${4:Why is this decision needed?}",
      "",
      "#### Decision",
      "",
      "${5:What did we decide?}",
      "",
      "#### Consequences",
      "",
      "- Positive: ${6:Positive impact}",
      "- Negative: ${7:Trade-off or risk}",
      "",
      "$0"
    ],
    "description": "Insert a DevSpec decision log section."
  },
  "DevSpec KaTeX Block": {
    "prefix": "dskatex",
    "body": [
      "$$",
      "${1:E = mc^2}",
      "$$",
      "$0"
    ],
    "description": "Insert a KaTeX math block."
  }
}
