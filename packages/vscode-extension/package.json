{
    "name": "devspec-markdown-vscode",
    "displayName": "DevSpec Markdown",
    "description": "VS Code live preview for Markdown with PlantUML, Mermaid, and PDF export.",
    "version": "0.0.8",
    "publisher": "dghuuloc",
    "icon": "images/devspec-markdown-icon-256.png",
    "galleryBanner": {
        "color": "#0f3fb8",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "Other",
        "Visualization"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/dghuuloc/devspec-markdown.git"
    },
    "files": [
        "out/**",
        "images/**",
        "media/**",
        "snippets/**",
        "node_modules/@devspec-markdown/core/dist/**",
        "node_modules/@devspec-markdown/core/vendor/**",
        "node_modules/@devspec-markdown/core/package.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "package.json"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onCommand:devspecMarkdown.openPreview",
        "onCommand:devspecMarkdown.exportHtml",
        "onCommand:devspecMarkdown.exportPdf",
        "onCommand:devspecMarkdown.checkDependencies",
        "onCommand:devspecMarkdown.installDependencies",
        "onCommand:devspecMarkdown.resetDependencyPrompt",
        "onCommand:devspecMarkdown.formatTable",
        "onCommand:devspecMarkdown.editing.toggleBold",
        "onCommand:devspecMarkdown.editing.toggleItalic",
        "onCommand:devspecMarkdown.editing.toggleCodeSpan",
        "onCommand:devspecMarkdown.editing.toggleMath",
        "onCommand:devspecMarkdown.editing.toggleCodeBlock",
        "onCommand:devspecMarkdown.editing.toggleMathBlock",
        "onCommand:devspecMarkdown.editing.toggleTaskList",
        "onCommand:devspecMarkdown.editing.toggleTaskCheck",
        "onCommand:devspecMarkdown.editing.toggleBulletList",
        "onCommand:devspecMarkdown.editing.toggleNumberedList",
        "onCommand:devspecMarkdown.toc.insertOrUpdate",
        "onCommand:devspecMarkdown.toc.remove",
        "onCommand:devspecMarkdown.template.newDocument",
        "onCommand:devspecMarkdown.template.insertDocumentSkeleton",
        "onCommand:devspecMarkdown.insert.apiSection",
        "onCommand:devspecMarkdown.insert.databaseTable",
        "onCommand:devspecMarkdown.insert.sequenceDiagram",
        "onCommand:devspecMarkdown.insert.mermaidFlowchart",
        "onCommand:devspecMarkdown.insert.mermaidStateDiagram",
        "onCommand:devspecMarkdown.insert.errorTable",
        "onCommand:devspecMarkdown.insert.testCaseTable",
        "onCommand:devspecMarkdown.insert.decisionLog",
        "onCommand:devspecMarkdown.insert.riskTable",
        "onCommand:devspecMarkdown.insert.block"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "devspecMarkdown.openPreview",
                "title": "DevSpec: Open Preview",
                "icon": "$(preview)"
            },
            {
                "command": "devspecMarkdown.exportHtml",
                "title": "DevSpec: Export Current Markdown to HTML"
            },
            {
                "command": "devspecMarkdown.exportPdf",
                "title": "DevSpec: Export Current Markdown to PDF",
                "icon": "$(file-pdf)"
            },
            {
                "command": "devspecMarkdown.checkDependencies",
                "title": "DevSpec: Check System Dependencies"
            },
            {
                "command": "devspecMarkdown.installDependencies",
                "title": "DevSpec: Install System Dependencies"
            },
            {
                "command": "devspecMarkdown.resetDependencyPrompt",
                "title": "DevSpec: Reset Dependency Prompt"
            },
            {
                "command": "devspecMarkdown.formatTable",
                "title": "DevSpec: Format Markdown Table"
            },
            {
                "command": "devspecMarkdown.editing.toggleBold",
                "title": "DevSpec: Toggle Bold"
            },
            {
                "command": "devspecMarkdown.editing.toggleItalic",
                "title": "DevSpec: Toggle Italic"
            },
            {
                "command": "devspecMarkdown.editing.toggleCodeSpan",
                "title": "DevSpec: Toggle Inline Code"
            },
            {
                "command": "devspecMarkdown.editing.toggleMath",
                "title": "DevSpec: Toggle Inline Math"
            },
            {
                "command": "devspecMarkdown.editing.toggleCodeBlock",
                "title": "DevSpec: Toggle Code Block"
            },
            {
                "command": "devspecMarkdown.editing.toggleMathBlock",
                "title": "DevSpec: Toggle Math Block"
            },
            {
                "command": "devspecMarkdown.editing.toggleTaskList",
                "title": "DevSpec: Toggle Task List"
            },
            {
                "command": "devspecMarkdown.editing.toggleTaskCheck",
                "title": "DevSpec: Toggle Task Check"
            },
            {
                "command": "devspecMarkdown.editing.toggleBulletList",
                "title": "DevSpec: Toggle Bullet List"
            },
            {
                "command": "devspecMarkdown.editing.toggleNumberedList",
                "title": "DevSpec: Toggle Numbered List"
            },
            {
                "command": "devspecMarkdown.toc.insertOrUpdate",
                "title": "DevSpec: Insert or Update Table of Contents"
            },
            {
                "command": "devspecMarkdown.toc.remove",
                "title": "DevSpec: Remove Table of Contents"
            },
            {
                "command": "devspecMarkdown.template.newDocument",
                "title": "DevSpec: Create New DevSpec Document"
            },
            {
                "command": "devspecMarkdown.template.insertDocumentSkeleton",
                "title": "DevSpec: Insert Document Skeleton"
            },
            {
                "command": "devspecMarkdown.insert.apiSection",
                "title": "DevSpec: Insert API Section"
            },
            {
                "command": "devspecMarkdown.insert.databaseTable",
                "title": "DevSpec: Insert Database Table Section"
            },
            {
                "command": "devspecMarkdown.insert.sequenceDiagram",
                "title": "DevSpec: Insert PlantUML Sequence Diagram"
            },
            {
                "command": "devspecMarkdown.insert.mermaidFlowchart",
                "title": "DevSpec: Insert Mermaid Flowchart"
            },
            {
                "command": "devspecMarkdown.insert.mermaidStateDiagram",
                "title": "DevSpec: Insert Mermaid State Diagram"
            },
            {
                "command": "devspecMarkdown.insert.errorTable",
                "title": "DevSpec: Insert Error Code Table"
            },
            {
                "command": "devspecMarkdown.insert.testCaseTable",
                "title": "DevSpec: Insert Test Case Table"
            },
            {
                "command": "devspecMarkdown.insert.decisionLog",
                "title": "DevSpec: Insert Decision Log"
            },
            {
                "command": "devspecMarkdown.insert.riskTable",
                "title": "DevSpec: Insert Risk Table"
            },
            {
                "command": "devspecMarkdown.insert.block",
                "title": "DevSpec: Insert Block..."
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "devspecMarkdown.openPreview",
                    "when": "editorLangId == markdown || resourceExtname == .md",
                    "group": "navigation@1"
                },
                {
                    "command": "devspecMarkdown.exportPdf",
                    "when": "editorLangId == markdown || resourceExtname == .md",
                    "group": "navigation@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "devspecMarkdown.openPreview",
                    "when": "editorLangId == markdown || resourceExtname == .md"
                },
                {
                    "command": "devspecMarkdown.exportHtml",
                    "when": "editorLangId == markdown || resourceExtname == .md"
                },
                {
                    "command": "devspecMarkdown.exportPdf",
                    "when": "editorLangId == markdown || resourceExtname == .md"
                },
                {
                    "command": "devspecMarkdown.checkDependencies"
                },
                {
                    "command": "devspecMarkdown.installDependencies"
                },
                {
                    "command": "devspecMarkdown.resetDependencyPrompt"
                }
            ]
        },
        "configuration": {
            "title": "DevSpec Markdown",
            "properties": {
                "devspecMarkdown.diagramSourceDir": {
                    "type": "string",
                    "default": "docs/diagrams/src",
                    "description": "Folder for separated PlantUML .puml files. Relative paths are resolved from the workspace root."
                },
                "devspecMarkdown.plantumlJarPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to plantuml.jar. If empty, the extension uses packages/core/vendor/plantuml.jar when available."
                },
                "devspecMarkdown.plantumlSecurityProfile": {
                    "type": "string",
                    "default": "SECURE",
                    "enum": [
                        "SECURE",
                        "UNSECURE"
                    ],
                    "description": "PlantUML security profile. Use UNSECURE only when you need remote includes."
                },
                "devspecMarkdown.previewDebounceMs": {
                    "type": "number",
                    "default": 700,
                    "description": "Delay before refreshing the custom live preview while typing. Larger values improve performance for large documents."
                },
                "devspecMarkdown.sectionNumbering": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically number headings."
                },
                "devspecMarkdown.sectionNumberMinLevel": {
                    "type": "number",
                    "default": 2,
                    "description": "Minimum heading level for automatic section numbering."
                },
                "devspecMarkdown.sectionNumberMaxLevel": {
                    "type": "number",
                    "default": 4,
                    "description": "Maximum heading level for automatic section numbering."
                },
                "devspecMarkdown.stripExistingSectionNumbers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Remove existing manual section numbers before generating automatic numbers."
                },
                "devspecMarkdown.browserPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional browser executable path for PDF export. If empty, the extension automatically detects Edge, Chrome, Brave, or Chromium from common install paths and PATH."
                },
                "devspecMarkdown.autoCheckDependencies": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically check DevSpec Markdown system dependencies when the extension starts."
                },
                "devspecMarkdown.previewScrollSync": {
                    "type": "boolean",
                    "default": true,
                    "description": "Synchronize scrolling between the Markdown editor and DevSpec preview."
                },
                "devspecMarkdown.previewZoomLevel": {
                    "type": "number",
                    "default": 1,
                    "minimum": 0.5,
                    "maximum": 3,
                    "description": "Initial zoom level for the DevSpec Markdown preview. 1 means 100%, 1.5 means 150%."
                },
                "devspecMarkdown.tableFormatter.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable DevSpec Markdown table formatting."
                },
                "devspecMarkdown.completion.katex.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable KaTeX command completions in Markdown files."
                },
                "devspecMarkdown.listEditing.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable DevSpec Markdown list editing commands."
                },
                "devspecMarkdown.toc.minLevel": {
                    "type": "number",
                    "default": 2,
                    "minimum": 1,
                    "maximum": 6,
                    "description": "Minimum heading level included by the DevSpec editor TOC command."
                },
                "devspecMarkdown.toc.maxLevel": {
                    "type": "number",
                    "default": 4,
                    "minimum": 1,
                    "maximum": 6,
                    "description": "Maximum heading level included by the DevSpec editor TOC command."
                },
                "devspecMarkdown.toc.title": {
                    "type": "string",
                    "default": "Table of Contents",
                    "description": "Title used by the DevSpec editor TOC command."
                },
                "devspecMarkdown.completion.devspec.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable DevSpec document, section, admonition, and diagram completions in Markdown files."
                }
            }
        },
        "keybindings": [
            {
                "command": "devspecMarkdown.exportPdf",
                "key": "ctrl+alt+p",
                "mac": "cmd+alt+p",
                "when": "editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.openPreview",
                "key": "ctrl+alt+v",
                "mac": "cmd+alt+v",
                "when": "editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.formatTable",
                "key": "ctrl+alt+t",
                "mac": "cmd+alt+t",
                "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.editing.toggleBold",
                "key": "ctrl+b",
                "mac": "cmd+b",
                "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.editing.toggleItalic",
                "key": "ctrl+alt+i",
                "mac": "cmd+alt+i",
                "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.editing.toggleCodeSpan",
                "key": "ctrl+shift+c",
                "mac": "cmd+shift+c",
                "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.editing.toggleMath",
                "key": "ctrl+shift+m",
                "mac": "cmd+shift+m",
                "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.editing.toggleTaskCheck",
                "key": "ctrl+alt+x",
                "mac": "cmd+alt+x",
                "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.template.newDocument",
                "key": "ctrl+alt+d",
                "mac": "cmd+alt+d",
                "when": "editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.insert.apiSection",
                "key": "ctrl+alt+a",
                "mac": "cmd+alt+a",
                "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.insert.block",
                "key": "ctrl+alt+/",
                "mac": "cmd+alt+/",
                "when": "editorTextFocus && !editorReadonly && editorLangId == markdown"
            }
        ],
        "snippets": [
            {
                "language": "markdown",
                "path": "./snippets/devspec-markdown.code-snippets"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "echo \"Use npm run package:vsix from the repository root.\" && exit 1",
        "copy:mermaid": "node scripts/copy-mermaid.js",
        "vscode:prepublish": "npm run copy:mermaid && npm run compile"
    },
    "dependencies": {
        "@devspec-markdown/core": "file:../core",
        "mermaid": "^11.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "@types/vscode": "^1.96.0",
        "@vscode/vsce": "^3.2.1",
        "typescript": "^5.7.3"
    }
}