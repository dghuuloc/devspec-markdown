{
    "name": "devspec-markdown-vscode",
    "displayName": "DevSpec Markdown",
    "description": "VS Code live preview for DevSpec Markdown with PlantUML, TOC, and PDF export.",
    "version": "0.0.5",
    "publisher": "dghuuloc",
    "icon": "images/devspec-markdown-icon-256.png",
    "galleryBanner": {
        "color": "#0f3fb8",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.96.0"
    },
    "categories": [
        "Other",
        "Visualization"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/dghuuloc/devspec-markdown.git"
    },
    "files": [
        "out/**",
        "images/**",
        "node_modules/@devspec-markdown/core/dist/**",
        "node_modules/@devspec-markdown/core/vendor/**",
        "node_modules/@devspec-markdown/core/package.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "package.json"
    ],
    "activationEvents": [
        "onStartupFinished",
        "onCommand:devspecMarkdown.openPreview",
        "onCommand:devspecMarkdown.exportHtml",
        "onCommand:devspecMarkdown.exportPdf",
        "onCommand:devspecMarkdown.checkDependencies",
        "onCommand:devspecMarkdown.installDependencies",
        "onCommand:devspecMarkdown.resetDependencyPrompt"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "devspecMarkdown.openPreview",
                "title": "DevSpec: Open Preview",
                "icon": "$(preview)"
            },
            {
                "command": "devspecMarkdown.exportHtml",
                "title": "DevSpec: Export Current Markdown to HTML"
            },
            {
                "command": "devspecMarkdown.exportPdf",
                "title": "DevSpec: Export Current Markdown to PDF",
                "icon": "$(file-pdf)"
            },
            {
                "command": "devspecMarkdown.checkDependencies",
                "title": "DevSpec: Check System Dependencies"
            },
            {
                "command": "devspecMarkdown.installDependencies",
                "title": "DevSpec: Install System Dependencies"
            },
            {
                "command": "devspecMarkdown.resetDependencyPrompt",
                "title": "DevSpec: Reset Dependency Prompt"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "devspecMarkdown.openPreview",
                    "when": "editorLangId == markdown || resourceExtname == .md",
                    "group": "navigation@1"
                },
                {
                    "command": "devspecMarkdown.exportPdf",
                    "when": "editorLangId == markdown || resourceExtname == .md",
                    "group": "navigation@2"
                }
            ],
            "commandPalette": [
                {
                    "command": "devspecMarkdown.openPreview",
                    "when": "editorLangId == markdown || resourceExtname == .md"
                },
                {
                    "command": "devspecMarkdown.exportHtml",
                    "when": "editorLangId == markdown || resourceExtname == .md"
                },
                {
                    "command": "devspecMarkdown.exportPdf",
                    "when": "editorLangId == markdown || resourceExtname == .md"
                },
                {
                    "command": "devspecMarkdown.checkDependencies"
                },
                {
                    "command": "devspecMarkdown.installDependencies"
                },
                {
                    "command": "devspecMarkdown.resetDependencyPrompt"
                }
            ]
        },
        "configuration": {
            "title": "DevSpec Markdown",
            "properties": {
                "devspecMarkdown.diagramSourceDir": {
                    "type": "string",
                    "default": "docs/diagrams/src",
                    "description": "Folder for separated PlantUML .puml files. Relative paths are resolved from the workspace root."
                },
                "devspecMarkdown.plantumlJarPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to plantuml.jar. If empty, the extension uses packages/core/vendor/plantuml.jar when available."
                },
                "devspecMarkdown.plantumlSecurityProfile": {
                    "type": "string",
                    "default": "SECURE",
                    "enum": [
                        "SECURE",
                        "UNSECURE"
                    ],
                    "description": "PlantUML security profile. Use UNSECURE only when you need remote includes."
                },
                "devspecMarkdown.previewDebounceMs": {
                    "type": "number",
                    "default": 700,
                    "description": "Delay before refreshing the custom live preview while typing. Larger values improve performance for large documents."
                },
                "devspecMarkdown.sectionNumbering": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically number headings."
                },
                "devspecMarkdown.sectionNumberMinLevel": {
                    "type": "number",
                    "default": 2,
                    "description": "Minimum heading level for automatic section numbering."
                },
                "devspecMarkdown.sectionNumberMaxLevel": {
                    "type": "number",
                    "default": 4,
                    "description": "Maximum heading level for automatic section numbering."
                },
                "devspecMarkdown.stripExistingSectionNumbers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Remove existing manual section numbers before generating automatic numbers."
                },
                "devspecMarkdown.browserPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional browser executable path for PDF export. If empty, the extension automatically detects Edge, Chrome, Brave, or Chromium from common install paths and PATH."
                },
                "devspecMarkdown.autoCheckDependencies": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically check DevSpec Markdown system dependencies when the extension starts."
                },
                "devspecMarkdown.previewScrollSync": {
                    "type": "boolean",
                    "default": true,
                    "description": "Synchronize scrolling between the Markdown editor and DevSpec preview."
                }
            }
        },
        "keybindings": [
            {
                "command": "devspecMarkdown.exportPdf",
                "key": "ctrl+alt+p",
                "mac": "cmd+alt+p",
                "when": "editorLangId == markdown"
            },
            {
                "command": "devspecMarkdown.openPreview",
                "key": "ctrl+alt+v",
                "mac": "cmd+alt+v",
                "when": "editorLangId == markdown"
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "echo \"Use npm run package:vsix from the repository root.\" && exit 1"
    },
    "dependencies": {
        "@devspec-markdown/core": "file:../core"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "@types/vscode": "^1.96.0",
        "@vscode/vsce": "^3.2.1",
        "typescript": "^5.7.3"
    }
}